# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC.
# Never put a key, a password or a connection string in here.

# Local development defaults to demo mode. Production release builds require
# the exact value "false" and valid real service settings; a demo release must
# be requested explicitly with `npm run build:demo`.
VITE_USE_MOCK_API=true

# Where your Express API lives. Local: http://localhost:3000
# Deployed: https://your-api.example.com
# No trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Public Supabase Auth values. These are safe to expose in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
