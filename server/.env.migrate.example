# Copy to .env.migrate only when applying reviewed database migrations.
# This file is not loaded by the normal API or browser client.
# Keep the migration login secret private and never commit .env.migrate.
MIGRATION_DATABASE_URL=postgresql://roomy_migrator:password@localhost:5432/roomy
# db/pool.js also expects the restricted runtime URL to be present.
DATABASE_URL=postgresql://roomy_runtime_login:password@localhost:5432/roomy
# For hosted Supabase connections, provide a trusted CA file if required.
# DATABASE_SSL_CA_FILE=C:\\path\\outside-repo\\supabase-ca.pem
NODE_ENV=development
