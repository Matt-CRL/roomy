# Copy to .env and fill in. Never commit .env or a real connection string.
# These are runtime API settings only. Database migrations use a separate
# .env.migrate file so the migration credential is never loaded by the API.
# DATABASE_URL is the non-owner runtime login; do not use the Supabase postgres
# or service_role database login here after the RLS cutover.
DATABASE_URL=postgresql://roomy_runtime_login:password@localhost:5432/roomy
# Optional outside local development; separate least-privilege worker login with
# access only to roomy_photo_cleanup. Required in production.
PHOTO_CLEANUP_DATABASE_URL=postgresql://roomy_photo_maintenance_login:password@localhost:5432/roomy
# For hosted Supabase connections, download the root certificate and point to
# its local path if the certificate is not already trusted by your OS.
# DATABASE_SSL_CA_FILE=C:\\path\\outside-repo\\supabase-ca.pem

# Supabase Project URL and publishable key identify the Auth project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Used only by the private photo routes; never send this key to the browser.
# Create a private bucket named roomy-item-photos in Supabase Storage.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PHOTO_BUCKET=roomy-item-photos

# Comma-separated browser origins, with no trailing slash or path.
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
# Set true only when the production API is served over HTTPS by its host/proxy.
# PUBLIC_HTTPS=false
# PORT is optional locally; deployed hosts normally set it.
